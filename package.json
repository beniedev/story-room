{
  "name": "story-native-writing-harness",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "scripts": {
    "prepare:font": "node scripts/materialize-font.mjs",
    "predev": "npm run prepare:font",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite",
    "server": "node server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run prepare:font",
    "build": "tsc --noEmit && vite build --mode site",
    "prebuild:local": "npm run prepare:font",
    "build:local": "tsc --noEmit && vite build --mode local-build --outDir dist-local",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "license:check": "node scripts/check-dependency-licenses.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^1.37.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
